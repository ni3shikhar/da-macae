server {
    listen 80;
    server_name _;

    # DNS_RESOLVER and BACKEND_URL are injected at container startup via envsubst.
    # Using a variable for proxy_pass defers DNS resolution to request time so
    # nginx starts successfully even if the backend isn't reachable yet.
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        set $backend "${BACKEND_URL}";
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_ssl_server_name on;
        proxy_ssl_name $proxy_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
    }

    # WebSocket proxy — rewrite /ws/ to /api/v1/ws/ to match backend router prefix
    location /ws/ {
        set $backend_ws "${BACKEND_URL}/api/v1/ws/";
        proxy_pass $backend_ws;
        proxy_http_version 1.1;
        proxy_ssl_verify off;
        proxy_ssl_server_name on;
        proxy_ssl_name $proxy_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $proxy_host;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Cache-bust index.html so new deploys are picked up immediately
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
    }

    # Hashed assets can be cached forever
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }
}
